      "ms-mem": {"x": 0,  "y": 12, "w": 8,  "h": 8},
      "sm-mem": {"x": 8,  "y": 12, "w": 8,  "h": 8},
      "ds-mem": {"x": 16, "y": 12, "w": 8,  "h": 8},
      "ms-gc":  {"x": 0,  "y": 20, "w": 8,  "h": 8},
