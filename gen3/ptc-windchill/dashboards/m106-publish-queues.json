{
  "name": "M106 - Publish Queues",
  "type": "dashboard",
  "content": {
    "version": 21,
    "variables": [],
    "tiles": {
      "hdr": {
        "type": "markdown",
        "content": "## PTC Windchill — Publisher Queues\nMetrics: `ext:ptc.windchill.queues.*` — Total Entries, Waiting/Ready Entries, Max Exec Time (seconds)"
      },
      "pq1": {
        "type": "data",
        "title": "PublisherQueue1",
        "queries": [
          {
            "id": "A",
            "expression": "timeseries avg(`ext:ptc.windchill.queues.total_entries`), by:{queue_name}\n| filter queue_name == \"PublisherQueue1\"",
            "enabled": true
          },
          {
            "id": "B",
            "expression": "timeseries avg(`ext:ptc.windchill.queues.waiting_ready_entries`), by:{queue_name}\n| filter queue_name == \"PublisherQueue1\"",
            "enabled": true
          },
          {
            "id": "C",
            "expression": "timeseries avg(`ext:ptc.windchill.queues.max_exec_time_seconds`), by:{queue_name}\n| filter queue_name == \"PublisherQueue1\"",
            "enabled": true
          }
        ],
        "visualization": "lineChart"
      },
