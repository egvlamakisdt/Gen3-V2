{
  "name": "M101 - Method Server Status",
  "type": "dashboard",
  "content": {
    "version": 21,
    "variables": [],
    "tiles": {
      "hdr": {
        "type": "markdown",
        "content": "## PTC Windchill — Method Server JVM Status\nFiltered by tag: `MethodServer`"
      },
      "cpu-time": {
        "type": "data",
        "title": "JVM Total CPU Time",
        "queries": [
          {
            "id": "A",
            "expression": "timeseries sum(`builtin:tech.jvm.threads.totalCpuTime`), by:{dt.entity.process_group_instance}\n| filter in(dt.entity.process_group_instance, entitySelector(\"type(PROCESS_GROUP_INSTANCE),tag(\\\"MethodServer\\\")\"))",
            "enabled": true
          }
        ],
        "visualization": "lineChart"
      },
      "mem-runtime": {
        "type": "data",
        "title": "JVM Runtime Memory (Free / Total / Max)",
        "queries": [
          {
            "id": "A",
            "expression": "timeseries avg(`builtin:tech.jvm.memory.runtime.free`), by:{dt.entity.process_group_instance}\n| filter in(dt.entity.process_group_instance, entitySelector(\"type(PROCESS_GROUP_INSTANCE),tag(\\\"MethodServer\\\")\"))",
            "enabled": true
          },
          {
            "id": "B",
            "expression": "timeseries avg(`builtin:tech.jvm.memory.runtime.total`), by:{dt.entity.process_group_instance}\n| filter in(dt.entity.process_group_instance, entitySelector(\"type(PROCESS_GROUP_INSTANCE),tag(\\\"MethodServer\\\")\"))",
            "enabled": true
          },
          {
            "id": "C",
            "expression": "timeseries avg(`builtin:tech.jvm.memory.runtime.max`), by:{dt.entity.process_group_instance}\n| filter in(dt.entity.process_group_instance, entitySelector(\"type(PROCESS_GROUP_INSTANCE),tag(\\\"MethodServer\\\")\"))",
            "enabled": true
          }
        ],
        "visualization": "lineChart"
      },
      "gc-time": {
        "type": "data",
        "title": "GC Collection Time",
        "queries": [
          {
            "id": "A",
            "expression": "timeseries sum(`builtin:tech.jvm.memory.gc.collectionTime`), by:{dt.entity.process_group_instance}\n| filter in(dt.entity.process_group_instance, entitySelector(\"type(PROCESS_GROUP_INSTANCE),tag(\\\"MethodServer\\\")\"))",
            "enabled": true
          }
        ],
        "visualization": "lineChart"
      },
      "gc-count": {
        "type": "data",
        "title": "GC Collection Count",
        "queries": [
          {
            "id": "A",
            "expression": "timeseries sum(`builtin:tech.jvm.memory.pool.collectionCount`), by:{dt.entity.process_group_instance}\n| filter in(dt.entity.process_group_instance, entitySelector(\"type(PROCESS_GROUP_INSTANCE),tag(\\\"MethodServer\\\")\"))",
            "enabled": true
          }
        ],
        "visualization": "lineChart"
      },
      "host-health": {
        "type": "data",
        "title": "Host Health — PTC MZ",
        "queries": [
          {
            "id": "A",
            "expression": "fetch dt.entity.host\n| filter in(id, entitySelector(\"type(HOST),tag(\\\"PTC\\\")\"))\n| fields entity.name, healthState\n| sort healthState",
            "enabled": true
          }
        ],
        "visualization": "table"
      },
      "problems": {
        "type": "data",
        "title": "Open Problems",
        "queries": [
          {
            "id": "A",
            "expression": "fetch dt.davis.problems\n| filter status == \"OPEN\"\n| fields title, severity, status, startTime\n| sort startTime desc",
            "enabled": true
          }
        ],
        "visualization": "table"
      }
    },
    "layouts": {
      "hdr":         {"x": 0,  "y": 0,  "w": 24, "h": 2},
      "cpu-time":    {"x": 0,  "y": 2,  "w": 12, "h": 8},
      "mem-runtime": {"x": 12, "y": 2,  "w": 12, "h": 8},
      "gc-time":     {"x": 0,  "y": 10, "w": 12, "h": 8},
      "gc-count":    {"x": 12, "y": 10, "w": 12, "h": 8},
      "host-health": {"x": 0,  "y": 18, "w": 12, "h": 8},
      "problems":    {"x": 12, "y": 18, "w": 12, "h": 8}
    }
  }
}
