{
  "name": "M105 - Process Queues",
  "type": "dashboard",
  "content": {
    "version": 21,
    "variables": [],
    "tiles": {
      "hdr": {
        "type": "markdown",
        "content": "## PTC Windchill — Process Queues\nMetrics: `ext:ptc.windchill.queues.*` — Total Entries, Waiting/Ready Entries, Max Exec Time (seconds)"
      },
      "q1-wfuser": {
        "type": "data",
        "title": "WfUserWorkQueue",
        "queries": [
          {
            "id": "A",
            "expression": "timeseries avg(`ext:ptc.windchill.queues.total_entries`), by:{queue_name}\n| filter queue_name == \"WfUserWorkQueue\"",
            "enabled": true
          },
          {
            "id": "B",
            "expression": "timeseries avg(`ext:ptc.windchill.queues.waiting_ready_entries`), by:{queue_name}\n| filter queue_name == \"WfUserWorkQueue\"",
            "enabled": true
          },
          {
            "id": "C",
            "expression": "timeseries avg(`ext:ptc.windchill.queues.max_exec_time_seconds`), by:{queue_name}\n| filter queue_name == \"WfUserWorkQueue\"",
            "enabled": true
          }
        ],
        "visualization": "lineChart"
      },
